<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".fragments.Main">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/auto_mouse_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/auto_mouse_bg">

            <!-- Top bar: hamburger + title -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/white"
                    android:contentDescription="Open menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="MouseBuster"
                    android:textColor="@color/card_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Scan / Stop Scanning button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Start Scanning"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/auto_mouse_cyan_dim"
                app:cornerRadius="12dp"
                app:icon="@drawable/baseline_bluetooth_24"
                app:iconGravity="textStart"
                app:iconTint="@color/auto_mouse_cyan"
                app:layout_constraintTop_toBottomOf="@+id/topBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.9" />

            <!-- Scanning progress indicator -->
            <ProgressBar
                android:id="@+id/scanProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:indeterminateTint="@color/auto_mouse_cyan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnScan" />

            <!-- Scrollable content area -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@+id/scanProgressBar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.92">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Paired Devices Section -->
                    <TextView
                        android:id="@+id/labelPaired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paired Devices"
                        android:textColor="@color/card_text"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="10dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPaired"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tvNoPaired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No paired devices found"
                        android:textColor="@color/auto_mouse_text_dim"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone" />

                    <!-- Available Devices Section (shown during scan) -->
                    <TextView
                        android:id="@+id/labelAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Devices"
                        android:textColor="@color/card_text"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerAvailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scanning for nearby devices..."
                        android:textColor="@color/auto_mouse_text_dim"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Navigation Drawer -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigation"
            style="@style/Widget.AutoMouse.NavigationView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:headerLayout="@layout/nav_header_mousedroid"
            app:menu="@menu/main_drawer_menu" />

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>