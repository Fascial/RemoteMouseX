<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="16dp">

    <data>
        <variable
            name="viewmodel"
            type="com.darusc.mousedroid.viewmodels.NumpadViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/auto_mouse_bg">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/numpadHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numpad"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/numpadToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                app:thumbTint="@color/auto_mouse_cyan"
                app:trackTint="@color/auto_mouse_cyan_dim"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/numpadFlow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            app:constraint_referenced_ids="num7,num8,num9,numdiv,num4,num5,num6,nummultiply,num1,num2,num3,numminus,numdot,num0,numenter,numplus"
            app:flow_horizontalGap="8dp"
            app:flow_horizontalStyle="spread"
            app:flow_maxElementsWrap="4"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="aligned"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/numpadHeader" />

        <Button
            android:id="@+id/num7"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="7" />

        <Button
            android:id="@+id/num8"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="8" />

        <Button
            android:id="@+id/num9"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="9" />

        <Button
            android:id="@+id/numdiv"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="/" />

        <Button
            android:id="@+id/num4"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="4" />

        <Button
            android:id="@+id/num5"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="5" />

        <Button
            android:id="@+id/num6"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="6" />

        <Button
            android:id="@+id/nummultiply"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="*" />

        <Button
            android:id="@+id/num1"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="1" />

        <Button
            android:id="@+id/num2"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="2" />

        <Button
            android:id="@+id/num3"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="3" />

        <Button
            android:id="@+id/numminus"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="-" />

        <!-- 4th Row -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/numdot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/auto_mouse_cyan"
            android:onClick="@{viewmodel::onButtonClick}"
            android:onLongClick="@{viewmodel::onButtonLongClick}"
            android:text="."
            android:textColor="#000000"
            app:iconTint="#000000"
            app:iconSize="28dp"
            app:icon="@drawable/backspace_vector"
            app:iconGravity="textEnd" />

        <Button
            android:id="@+id/num0"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/numenter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/auto_mouse_cyan"
            android:onClick="@{viewmodel::onButtonClick}"
            app:iconTint="#000000"
            app:iconSize="28dp"
            app:icon="@drawable/enter_vector"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/numplus"
            style="@style/NumpadKey"
            android:onClick="@{viewmodel::onButtonClick}"
            android:text="+" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>