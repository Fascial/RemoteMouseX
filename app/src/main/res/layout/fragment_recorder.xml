<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.darusc.mousedroid.viewmodels.RecorderViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trackpad Recorder"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Touchpad Area -->
                <FrameLayout
                    android:id="@+id/touchpadContainer"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/touchpad_bg">

                    <View
                        android:id="@+id/touchpadSensor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.1" />
                </FrameLayout>

                <!-- Recording Controls -->
                <LinearLayout
                    android:id="@+id/recordingControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecord"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> viewmodel.toggleRecording()}"
                        android:text="Record"
                        app:strokeColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayback"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> viewmodel.togglePlayback()}"
                        android:text="Play"
                        app:strokeColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Save"
                        app:strokeColor="@color/white" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearRecording"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:onClick="@{() -> viewmodel.clearRecording()}"
                    android:text="Clear Recording"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="#888888" />

                <!-- Event Count -->
                <TextView
                    android:id="@+id/recordingEventCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:textColor="@color/card_text2"
                    android:textSize="12sp" />

                <!-- Playback Options -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playbackOptionsHeader"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Options"
                    android:textColor="#888888"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="textEnd"
                    app:iconTint="#888888" />

                <LinearLayout
                    android:id="@+id/playbackOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/rounded_control">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Playback Interval (ms)"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIntervalMinus"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:onClick="@{() -> viewmodel.decrementPlaybackInterval()}"
                            app:icon="@drawable/ic_remove"
                            app:iconTint="@color/white" />

                        <EditText
                            android:id="@+id/playbackIntervalInput"
                            android:layout_width="60dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/card_gray"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:inputType="number"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIntervalPlus"
                            style="@style/Widget.MaterialComponents.Button.Icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:onClick="@{() -> viewmodel.incrementPlaybackInterval()}"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/loopToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="@={viewmodel.isLoopEnabled}"
                        android:text="Loop Playback"
                        android:textColor="@color/white" />

                </LinearLayout>

                <!-- Saved Recordings -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/savedRecordingsHeader"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved Recordings"
                    android:textColor="#888888"
                    app:icon="@drawable/ic_arrow_drop_down"
                    app:iconGravity="textEnd"
                    app:iconTint="#888888" />

                <LinearLayout
                    android:id="@+id/savedRecordingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/rounded_control">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="(No saved recordings yet)"
                        android:textColor="@color/card_text2"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
