<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.automouse.viewmodels.RecorderViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="115dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trackpad Recorder"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/mouseButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeftClick"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:onClick="@{viewmodel::onMouseButtonClick}"
                    android:text="Left"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiddleClick"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:onClick="@{viewmodel::onMouseButtonClick}"
                    android:text="Middle"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRightClick"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="@{viewmodel::onMouseButtonClick}"
                    android:text="Right"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/touchpadContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/touchpad_bg"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintBottom_toTopOf="@+id/mouseButtonsRow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title">

                <View
                    android:id="@+id/touchpadSensor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet"
            android:elevation="12dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="false"
            app:behavior_peekHeight="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="48dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Drag Handle -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="#666666"
                    android:layout_marginBottom="24dp" />

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="32dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Config Panel"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <!-- SECTION: RECORDER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recording Activity"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecord"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:text="REC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="44dp"
                        app:backgroundTint="#D32F2F"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayback"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> viewmodel.togglePlayback()}"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/white"
                        app:cornerRadius="16dp"
                        app:strokeColor="#666666" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Save"
                        app:cornerRadius="16dp"
                        app:strokeColor="#666666"
                        android:textColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearRecording"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> viewmodel.clearRecording()}"
                        android:text="Clear"
                        android:textColor="#666666" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginBottom="32dp" />

                <!-- SECTION: PLAYBACK SETTINGS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback Settings"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Playback Speed"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Multiplier (1.0 = normal)"
                            android:textColor="#888888"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:id="@+id/btnIntervalMinus"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:text="−"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:onClick="@{() -> viewmodel.decrementPlaybackInterval()}"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"/>
                            
                        <LinearLayout
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center">
                            
                            <EditText
                                android:id="@+id/playbackIntervalInput"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:minWidth="24dp"
                                android:background="@null"
                                android:textColor="@color/white"
                                android:gravity="center_vertical|end"
                                android:inputType="numberDecimal"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:hint="1.0"
                                android:textColorHint="#666666" />
                                
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="x"
                                android:textColor="@color/white"
                                android:gravity="center_vertical|start"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                            
                        <TextView
                            android:id="@+id/btnIntervalPlus"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:onClick="@{() -> viewmodel.incrementPlaybackInterval()}"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/loopToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="@={viewmodel.isLoopEnabled}"
                    android:text="Auto-loop Playback"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginBottom="32dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A2A"
                    android:layout_marginBottom="32dp" />

                <!-- SECTION: SAVED RECORDINGS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Library"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/savedRecordingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:descendantFocusability="blocksDescendants">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="No saved recordings yet"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
